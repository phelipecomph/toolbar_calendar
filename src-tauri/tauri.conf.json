{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Toolbar Calendar",
  "version": "0.1.0",
  "identifier": "com.agendastrip",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "strip",
        "title": "Toolbar Calendar",
        "url": "index.html",
        "width": 1280,
        "height": 24,
        "x": 0,
        "y": 0,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "shadow": false
      },
      {
        "label": "detail",
        "title": "Detail",
        "url": "detail.html",
        "width": 320,
        "height": 200,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "focus": false,
        "shadow": true
      },
      {
        "label": "settings",
        "title": "Strip position",
        "url": "settings.html",
        "width": 240,
        "height": 230,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
